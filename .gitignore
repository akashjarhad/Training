# Python virtual environment
.venv/
venv/
env/
ENV/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/

# Environments & secrets
.env
.env.local

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo

# Downloaded source documents (~10 MB of government PDFs).
# Re-fetch them with:  python -m app.fetch
# manifest.json is tracked so each download stays reproducible and checksummed.
data/raw/*
!data/raw/manifest.json

# Runtime-generated citizen questions submitted via the FastAPI /questions
# endpoint. Not source data, so it stays out of version control.
data/questions.json

# Request metrics logged by /ask endpoint
data/metrics.json


# Local Streamlit per-machine config (API base URL etc.)
.streamlit/secrets.toml

# Chroma vector index is committed so Render doesn't need to rebuild it
# data/chroma/
