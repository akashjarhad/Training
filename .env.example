# AapleSeva chat assistant - LLM provider configuration.
# Copy this file to ".env" and fill in real values. ".env" is gitignored and
# never committed; this ".env.example" template is tracked.
#
# You only need ONE provider's key. Choose which one with LLM_PROVIDER.

# Which provider to use: groq | gemini
LLM_PROVIDER=groq

# Optional: override the default model for the chosen provider.
# LLM_MODEL=

# Groq - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Set to 1 to return a canned response without calling any API (dev/demo).
LLM_MOCK=0
