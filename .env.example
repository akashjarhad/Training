# AapleSeva Environment Configuration
# Copy this file to .env and fill in your API keys

# LLM Provider (groq or gemini)
LLM_PROVIDER=groq

# Mock mode (set to 1 for testing without API keys)
LLM_MOCK=0

# Groq Configuration (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Configuration (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# API Base URL (for UI to connect to API in Docker)
API_BASE_URL=http://api:8000
